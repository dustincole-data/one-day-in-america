{
  "name": "one-day-in-america",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "One Day in America — an ATUS-grounded data-art piece about the shape of a single American day.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
