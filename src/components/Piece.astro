---
// One structure, three grounds. Every route renders this component; the only
// thing that varies is the skin, which supplies the ground, the ink and the
// twelve-major palette as CSS custom properties.
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/fragment-mono';
import stats from '../gen/stats.json';
import { MAJORS, LABELS, DARK, BAND_ORDER } from '../lib/atus/meta.js';
import { SKINS, SKIN_ORDER, SKIN_PATH } from '../lib/atus/skins.js';
import Findings from './Findings.astro';
import Explorer from './Explorer.astro';
import '../styles/piece.css';

const { skin: skinKey } = Astro.props;
const skin = SKINS[skinKey];

const avg = Object.fromEntries(stats.ledger.byMajor.map((r) => [r.major, r.y2024]));
const fmtAvg = (min) => {
  const r = Math.round(min), hh = Math.floor(r / 60), mm = r % 60;
  return hh ? `${hh}h ${String(mm).padStart(2, '0')}m` : `${mm}m`;
};
const h = Object.fromEntries(stats.headline.hourly.map((r) => [r.hour, r]));
const hw = Object.fromEntries(stats.headline.hourlyWorkers.map((r) => [r.hour, r]));

const title = `One Day in America — ${skin.name}`;
// C11: away from the graphic the claim is stated as the modal share, never as
// "no two days are alike".
const desc = `Every American day, drawn from ${stats.meta.n2024.toLocaleString()} real diary days. ` +
  `In the 3 a.m. hour the most common single activity holds ${stats.headline.at3am}% of the country; at noon, ${stats.headline.atNoon}%.`;

const cssVars = [
  `--bg:${skin.bg}`, `--ink:${skin.ink}`, `--muted:${skin.muted}`, `--hair:${skin.hair}`,
  `--card:${skin.card}`, `--card-solid:${skin.cardSolid}`, `--well:${skin.well}`, `--strong:${skin.strong}`,
  `--fill-a:${skin.fillAlpha ?? 1}`,
  ...MAJORS.map((m) => `--c-${m}:${skin.palette[m]}`),
].join(';');
---

<!doctype html>
<html lang="en" data-skin={skin.key} style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={`/og/${skin.key}.png`} />
    <meta name="theme-color" content={skin.bg} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style set:html={`:root{color-scheme:${skin.scheme}}`}></style>
  </head>

  <body>
    <div class="scrolly" id="fray" data-skin={skin.key}>
      <div class="stage">
        <canvas aria-label="2,600 real diary days drawn as horizontal threads across one day, grouped by activity"></canvas>
        <p class="loading">weaving 2,600 days…</p>
        <div class="hairline" aria-hidden="true"></div>
        <div class="readout" aria-hidden="true"></div>
        <div class="axis" aria-hidden="true"></div>
        <header class="brand">
          <a href="/">One Day in America</a><span>·</span><b>{skin.name}</b>
        </header>
        <button class="keybtn" aria-expanded="false">key</button>
        <aside class="legend" inert>
          <p class="lhead">average day, 2024</p>
          {BAND_ORDER.map((m) => (
            <button data-major={m}>
              <i style={`background:var(--c-${m})`}></i><span>{LABELS[m]}</span><b>{fmtAvg(avg[m])}</b>
            </button>
          ))}
        </aside>
      </div>

      <section class="step hero" data-galpha="0.42">
        <div class="card">
          <h1>Everyone’s 3&nbsp;a.m. looks the same.<br />Nobody’s noon does.</h1>
          <p>
            {stats.meta.n2024.toLocaleString()} Americans each wrote down one whole day for the
            Bureau of Labor Statistics in 2024. 2,600 of those days are drawn here as threads,
            4&nbsp;a.m. to 4&nbsp;a.m. Color is what that person was doing.
          </p>
          <p class="cue" aria-hidden="true">scroll ↓</p>
        </div>
      </section>

      <section class="step" data-dim="1320,1439">
        <div class="card">
          <h2>The quietest hour in America</h2>
          <p>
            In the 3&nbsp;a.m. hour, <b>{stats.headline.at3am}%</b> of the country shares a single
            activity — {stats.headline.asleepAt3am}% are simply asleep. From 2 to 4&nbsp;a.m.,
            agreement never drops below 95%.
          </p>
        </div>
      </section>

      <section class="step" data-dim="60,360">
        <div class="card">
          <h2>Then it frays</h2>
          <p>
            At 6&nbsp;a.m., <b>{h[6].share}%</b> are still on the same thing. Two hours later no
            single activity holds even 30% — and the fabric stays loose until dark.
          </p>
        </div>
      </section>

      <section class="step" data-dim="480,540">
        <div class="card">
          <h2>Noon is the loosest hour</h2>
          <p>
            The most common activity at noon — work — holds <b>{stats.headline.atNoon}%</b> of the
            country. The other three quarters are spread across eleven other bands. The gap between
            3&nbsp;a.m. and noon: <b>{stats.headline.gapPp} points</b>.
          </p>
        </div>
      </section>

      <section class="step" data-dim="960,1200">
        <div class="card">
          <h2>Evening pulls the threads back</h2>
          <p>
            By 8&nbsp;p.m., the biggest band is leisure — <b>{h[20].share}%</b> of the country, and
            most of those minutes are television. By 11&nbsp;p.m., <b>{h[23].share}%</b> agree
            again.
          </p>
        </div>
      </section>

      <section class="step" data-filter="workers6wd" data-dim="540,960">
        <div class="card">
          <h2>Work is the great synchronizer</h2>
          <p>
            Just the people who put in six or more hours on a weekday: <b>{hw[14].share}%</b> are
            inside the same hour of work at 2&nbsp;p.m. Their loosest hour isn’t noon — it’s
            6&nbsp;p.m., when the office lets out and the day scatters one last time.
          </p>
        </div>
      </section>

      <section class="step" data-filter="everyone" data-explore>
        <div class="card">
          <h2>Every thread is a real person</h2>
          <p>Tap a thread to follow one whole day. Or re-weave the fabric:</p>
          <p class="cue cue-down" aria-hidden="true">then keep going ↓</p>
        </div>
      </section>

      <div class="chips" inert>
        <button class="chip on" data-filter="everyone">Everyone</button>
        <button class="chip" data-filter="worked">Worked that day</button>
        <button class="chip" data-filter="weekend">Weekend</button>
        <button class="chip" data-filter="kids">Kids at home</button>
        <button class="chip" data-filter="age65">65 and over</button>
      </div>
      <aside class="daycard" inert></aside>
    </div>

    <main class="findings">
      <div class="findings-intro">
        <p class="f-kicker">The rest of the day</p>
        <p>
          The weave above is one question asked of this data: how much of the country is doing the
          same thing at once. Here is everything else worth knowing in it, and then a way to ask
          your own questions.
        </p>
      </div>

      <Findings />
      <Explorer />
    </main>

    <footer>
      <p class="source">{stats.meta.sourceLine}</p>
      <p class="fine">
        Civilian, noninstitutional population age 15 and over, living in households, 50 states and
        D.C. Activities are the 12 published ATUS categories; every share is weighted with BLS
        person-day weights. The 2,600 drawn days are a systematic probability-proportional-to-size
        sample of all {stats.meta.n2024.toLocaleString()} — so equal ink per thread draws an honest
        picture. Hour figures are the share of that clock hour spent on the most common single
        activity. Sections 03 through 07 pool {stats.explore.years[0]} and {stats.explore.years[1]}
        {' '}for sample size. 2020 is excluded: the survey was suspended for part of that year and
        BLS publishes no annual estimate for it.
      </p>

      <nav class="skinnav" aria-label="Ground">
        <span>Same piece, three grounds:</span>
        {SKIN_ORDER.map((k) => (
          <a href={SKIN_PATH[k]} aria-current={k === skin.key ? 'page' : undefined}>{SKINS[k].name}</a>
        ))}
      </nav>

      <p class="sig">
        <a href="https://dustincoledata.com">Dustin Cole Data</a>
      </p>
    </footer>

    <script>
      import { boot } from '../lib/fray/main.js';
      import { boot as bootExplorer } from '../lib/explore/main.js';

      const root = document.getElementById('fray');
      boot(root);

      const ex = document.querySelector('[data-explorer]');
      // the explorer payload is 190 KB — only fetch it once it is close to view
      const exIo = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        exIo.disconnect();
        bootExplorer(ex);
      }, { rootMargin: '400px' });
      exIo.observe(ex);

      // legend / key toggle
      const btn = document.querySelector('.keybtn');
      const legend = document.querySelector('.legend');
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        legend.classList.toggle('show', open);
        legend.inert = !open;
      });
    </script>
  </body>
</html>
