---
import '@fontsource-variable/besley';
import '@fontsource-variable/literata';
import stats from '../gen/stats.json';
import { LIGHT } from '../lib/atus/meta.js';

const fmt = (min) => {
  const r = Math.round(min), h = Math.floor(r / 60), m = r % 60;
  return h ? `${h}h ${String(m).padStart(2, '0')}m` : `${m}m`;
};
const L = stats.ledger.byMajor.reduce((a, r) => ((a[r.major] = r), a), {});
const F = stats.freeTime;
const G = stats.gap;
const title = 'The Ledger — One Day in America';
const desc = `Every day is exactly 1,440 minutes. Where America actually spends them, from ${stats.meta.n2024.toLocaleString()} diary days — and who actually has time left over.`;

// gender mini-figure geometry (leisure rows, tv shaded)
const rowW = 331.3; // men leisure = full width reference
const pct = (v) => (v / rowW * 100).toFixed(2) + '%';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="/og/ledger.png" />
    <meta name="theme-color" content="#f6f6f4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div id="ledger">
      <header class="masthead">
        <a href="/">One Day in America</a>
        <b>The Ledger</b>
      </header>

      <div class="split">
        <div class="figure">
          <div class="fig-inner">
            <canvas class="waffle" aria-label="The average American day drawn as 1,440 minute tiles, grouped into activity blocks"></canvas>
            <div class="tip" hidden></div>
            <p class="fig-note">each tile is one minute of the average day</p>
          </div>
        </div>

        <main class="acts">
          <section class="act hero" data-act data-group="y2024">
            <h1>Every day is exactly 1,440&nbsp;minutes.</h1>
            <p class="lede">
              No one gets more. No one gets less. {stats.meta.n2024.toLocaleString()} Americans
              told the Bureau of Labor Statistics how they spent every one of theirs — this is
              the country’s average day, drawn minute by minute.
            </p>
            <p class="hint" aria-hidden="true">keep reading — the tiles move ↓</p>
          </section>

          <section class="act" data-act data-group="y2019">
            <h2>Five years rearranged the day</h2>
            <p>
              This is the day as it looked in <b>2019</b>. Watch it become <b>2024</b> as you
              read on: work hands over <b>{fmt(Math.abs(L.work.delta))}</b> a day, household
              work takes <b>{fmt(L.household.delta)}</b> more, sleep and personal care take
              <b> {fmt(L.personal_care.delta)}</b>. Leisure did not gain a minute.
            </p>
          </section>

          <section class="act" data-act data-group="y2024">
            <h2>…and the books still balance</h2>
            <p>
              The day is a fixed budget, so every minute gained somewhere was surrendered
              somewhere else. The five-year ledger, 2019 → 2024:
            </p>
            <ul class="delta-list">
              <li><i style={`background:${LIGHT.household}`}></i>household work <b class="up">+{fmt(L.household.delta)}</b></li>
              <li><i style={`background:${LIGHT.personal_care}`}></i>sleep &amp; personal care <b class="up">+{fmt(L.personal_care.delta)}</b></li>
              <li><i style={`background:${LIGHT.eating_drinking}`}></i>eating &amp; drinking <b class="up">+{fmt(L.eating_drinking.delta)}</b></li>
              <li><i style={`background:${LIGHT.work}`}></i>work <b class="down">−{fmt(Math.abs(L.work.delta))}</b></li>
              <li><i style={`background:${LIGHT.leisure_sports}`}></i>leisure &amp; sports <b class="down">−{fmt(Math.abs(L.leisure_sports.delta))}</b>*</li>
              <li><i style={`background:${LIGHT.purchasing}`}></i>shopping <b class="down">−{fmt(Math.abs(L.purchasing.delta))}</b></li>
            </ul>
            <p class="aside">*inside the estimate’s noise floor — the honest reading is “did not gain”.</p>
          </section>

          <section class="act" data-act data-group="workedKidsU6">
            <h2>Who actually has time</h2>
            <p>
              The average hides a spread of five and a half hours. A person who worked that day
              while raising a child under six keeps <b>{fmt(F.workedKidsU6.free)}</b> of free
              time — and <b>{Math.round(F.workedKidsU6.under3h)}%</b> of their days have less
              than three hours. Someone with no job and no kids at home keeps
              <b> {fmt(F.noWorkNoKids.free)}</b>. A retiree-age American,
              <b> {fmt(F.age65.free)}</b>.
            </p>
            <div class="picker" role="group" aria-label="Choose a group">
              <button class="gbtn" data-group="y2024">Everyone</button>
              <button class="gbtn" data-group="worked">Worked that day</button>
              <button class="gbtn on" data-group="workedKidsU6">Worked, child under 6</button>
              <button class="gbtn" data-group="age65">65 and over</button>
              <button class="gbtn" data-group="noWorkNoKids">No job, no kids</button>
              <button class="gbtn" data-group="weekday">Weekday</button>
              <button class="gbtn" data-group="weekend">Weekend</button>
            </div>
            <dl class="gstats">
              <div><dt>free time</dt><dd data-free></dd></div>
              <div><dt>work + chores + care</dt><dd data-obl></dd></div>
              <div><dt>days under 3 free hours</dt><dd data-u3></dd></div>
            </dl>
          </section>

          <section class="act" data-act data-group="y2024" data-tv>
            <h2>Half of all free time is one activity</h2>
            <p>
              America’s free time comes to about {fmt(F.everyone.free)} a day. Television takes
              <b> {stats.tv.shareOfFree}%</b> of it — <b>{fmt(stats.tv.mean)}</b> for the average
              person, {fmt(stats.tv.amongWatchers)} among the {Math.round(stats.tv.watchedShare)}%
              who watched at all. Socializing in person: <b>{fmt(stats.tv.socialMean)}</b>.
              On {Math.round(stats.tv.zeroDays.social)}% of days, an American socializes for
              zero minutes.
            </p>
          </section>

          <section class="act" data-act data-group="men">
            <h2>The 48-minute gap</h2>
            <p>
              Men average <b>{fmt(G.menLeisure)}</b> of daily leisure; women,
              <b> {fmt(G.womenLeisure)}</b> — a gap of 48 minutes that survives every slice of
              the data. Then the twist: <b>{fmt(G.tvPortion)}</b> of it is television.
            </p>
            <figure class="bars">
              <figcaption>leisure per day, 2023–24 · darker area is television</figcaption>
              <div class="bar">
                <span class="who">men</span>
                <div class="track">
                  <div class="fill" style={`width:${pct(G.menLeisure)};background:${LIGHT.leisure_sports}`}>
                    <div class="tv" style={`width:${(G.menTv / G.menLeisure * 100).toFixed(1)}%`}></div>
                  </div>
                </div>
                <b>{fmt(G.menLeisure)}</b>
              </div>
              <div class="bar">
                <span class="who">women</span>
                <div class="track">
                  <div class="fill" style={`width:${pct(G.womenLeisure)};background:${LIGHT.leisure_sports}`}>
                    <div class="tv" style={`width:${(G.womenTv / G.womenLeisure * 100).toFixed(1)}%`}></div>
                  </div>
                </div>
                <b>{fmt(G.womenLeisure)}</b>
              </div>
            </figure>
            <p>
              Add up all work instead — paid work, household work, caregiving — and the totals
              nearly cancel: <b>{fmt(G.menTotal)}</b> for men, <b>{fmt(G.womenTotal)}</b> for
              women. Who works more isn’t the story. Who gets the couch afterward is.
            </p>
          </section>
        </main>
      </div>

      <footer>
        <p class="source">{stats.meta.sourceLine}</p>
        <p class="fine">
          Civilian, noninstitutional population age 15 and over, living in households, 50 states
          and D.C. Activities are the 12 published ATUS categories, population-weighted. Group
          figures pool the 2023 and 2024 surveys; the five-year shift compares 2019 with 2024.
          The pandemic interrupted the 2020 survey — BLS states annual 2020 estimates cannot be
          made, so the years between are not shown. “Free time” is leisure and sports plus
          organizational, civic and religious activity, phone and mail, and the survey’s
          residual category.
        </p>
        <nav>
          <span>Three ways to read the same day:</span>
          <a href="/fray">The Fray</a>
          <a aria-current="page" href="/ledger">The Ledger</a>
          <a href="/terrain">The Terrain</a>
        </nav>
      </footer>
    </div>

    <script>
      import { boot } from '../lib/ledger/main.js';
      boot(document.getElementById('ledger'));
    </script>

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f6f6f4;
        --ink: #16161c;
        --muted: #57575f;
        --hair: rgba(22, 22, 28, 0.14);
        --serif: 'Literata Variable', Georgia, serif;
        --disp: 'Besley Variable', Georgia, serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--bg); color: var(--ink); overflow-x: clip; }
      body { font: 400 1.02rem/1.62 var(--serif); }
      a { color: inherit; }

      .masthead {
        position: fixed; top: 0; left: 0; right: 0; z-index: 10;
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 14px 22px; pointer-events: none;
      }
      .masthead a { pointer-events: auto; font: 500 0.82rem var(--serif); text-decoration: none; opacity: 0.6; }
      .masthead a:hover { opacity: 1; }
      .masthead b { font: 700 0.82rem var(--disp); letter-spacing: 0.01em; }

      .split { display: grid; grid-template-columns: minmax(0, 54%) minmax(0, 46%); }
      .figure { position: sticky; top: 0; height: 100dvh; }
      .fig-inner { position: absolute; inset: 6vh 2vw 5vh 3vw; display: flex; flex-direction: column; }
      .waffle { flex: 1; width: 100%; min-height: 0; touch-action: pan-y; }
      .fig-note { margin: 8px 0 0; text-align: center; font: italic 0.78rem/1.4 var(--serif); color: var(--muted); }
      .tip {
        position: absolute; z-index: 5; pointer-events: none; max-width: 300px;
        background: var(--ink); color: #fbfbf9; font: 0.78rem/1.45 var(--serif);
        padding: 6px 10px; border-radius: 6px;
      }
      .tip b { font-family: var(--disp); font-weight: 600; }

      .acts { padding: 0 clamp(20px, 4vw, 64px); }
      .act { min-height: 96vh; display: flex; flex-direction: column; justify-content: center; max-width: 34rem; }
      .act.hero { min-height: 100vh; }
      h1 {
        margin: 0 0 0.5em; font: 800 clamp(1.9rem, 3.4vw, 2.9rem)/1.12 var(--disp);
        letter-spacing: -0.012em; text-wrap: balance;
      }
      .lede { font-size: 1.08rem; color: var(--ink); }
      .hint { font: italic 0.85rem var(--serif); color: var(--muted); margin-top: 2em; }
      h2 { margin: 0 0 0.5em; font: 700 1.35rem/1.2 var(--disp); letter-spacing: -0.005em; text-wrap: balance; }
      .act p { margin: 0 0 1em; color: var(--muted); }
      .act p b, .act li b { color: var(--ink); font-family: var(--disp); font-weight: 700; font-size: 0.95em; }
      .aside { font-style: italic; font-size: 0.85rem; }

      .delta-list { list-style: none; margin: 0 0 0.8em; padding: 0; }
      .delta-list li {
        display: flex; align-items: center; gap: 10px; padding: 7px 0;
        border-bottom: 1px solid var(--hair); font-size: 0.95rem; color: var(--muted);
      }
      .delta-list i { width: 12px; height: 12px; border-radius: 3px; flex: none; }
      .delta-list b { margin-left: auto; }
      .delta-list .up { color: #1c7c43; }
      .delta-list .down { color: #b3372c; }

      .picker { display: flex; flex-wrap: wrap; gap: 7px; margin: 1.1em 0; }
      .gbtn {
        font: 500 0.8rem var(--serif); color: var(--muted); background: none;
        border: 1px solid var(--hair); border-radius: 999px; padding: 6px 13px; cursor: pointer;
      }
      .gbtn:hover { color: var(--ink); border-color: var(--ink); }
      .gbtn.on { color: var(--bg); background: var(--ink); border-color: var(--ink); }

      .gstats { display: flex; gap: clamp(14px, 3vw, 34px); margin: 0.4em 0 0; flex-wrap: wrap; }
      .gstats div { min-width: 96px; }
      .gstats dt { font: italic 0.78rem var(--serif); color: var(--muted); }
      .gstats dd { margin: 2px 0 0; font: 700 1.5rem var(--disp); font-variant-numeric: tabular-nums; }

      .bars { margin: 1.4em 0; }
      .bars figcaption { font: italic 0.78rem var(--serif); color: var(--muted); margin-bottom: 10px; }
      .bar { display: grid; grid-template-columns: 3.4em 1fr 4.4em; align-items: center; gap: 10px; margin: 7px 0; }
      .bar .who { font: 500 0.85rem var(--serif); color: var(--muted); }
      .bar .track { position: relative; }
      .bar .fill { height: 26px; border-radius: 4px; position: relative; overflow: hidden; }
      .bar .tv { position: absolute; inset: 0 auto 0 0; background: rgba(22, 22, 28, 0.38); }
      .bar b { font: 700 0.95rem var(--disp); font-variant-numeric: tabular-nums; }

      footer { border-top: 1px solid var(--hair); padding: 44px clamp(20px, 4vw, 64px) 60px; }
      .source { font: 600 0.85rem var(--disp); margin: 0 0 12px; }
      .fine { color: var(--muted); font-size: 0.85rem; max-width: 66ch; margin: 0 0 24px; }
      footer nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 0.92rem; align-items: baseline; }
      footer nav span { color: var(--muted); font-size: 0.85rem; font-style: italic; }
      footer nav a { text-underline-offset: 4px; }
      footer nav a[aria-current] { text-decoration: none; color: var(--muted); }

      @media (max-width: 899px) {
        .split { display: block; }
        .figure { position: sticky; top: 0; height: 52dvh; z-index: 2; background: var(--bg); border-bottom: 1px solid var(--hair); }
        .fig-inner { inset: 7vh 3vw 2vh; }
        .fig-note { display: none; }
        .acts { position: relative; z-index: 1; padding: 0 6vw; }
        .act { min-height: 68vh; max-width: none; justify-content: flex-start; padding-top: 3.5vh; }
        .act.hero { min-height: 72vh; }
        h1 { font-size: clamp(1.6rem, 6.4vw, 2.1rem); }
        .gstats dd { font-size: 1.25rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .hint { display: none; }
      }
    </style>
  </body>
</html>
