---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/chivo-mono';
import stats from '../gen/stats.json';

const I = stats.indoors;
const h = Object.fromEntries(stats.headline.hourly.map((r) => [r.hour, r]));
const title = 'The Terrain — One Day in America';
const desc = `The American day as a mountain range: height is the share of the country on each activity, minute by minute. The at-home share of work minutes went ${I.homeMinuteShare2019}% → ${I.homeMinuteShare2024}% in five years.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="/og/terrain.png" />
    <meta name="theme-color" content="#10122b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="scrolly" id="terrain">
      <div class="stage stage3d">
        <canvas aria-label="The American day drawn as a 3D mountain range: one ridge per activity, height is the share of the country at each minute"></canvas>
        <p class="loading">raising the terrain…</p>
        <div class="labels" aria-hidden="true"></div>
        <div class="readout" aria-hidden="true"></div>
        <header class="brand">
          <a href="/">One Day in America</a><span>·</span><b>The Terrain</b>
        </header>
      </div>

      <section class="step hero" data-view="hero">
        <div class="card">
          <h1>The day has a shape.</h1>
          <p>
            Every ridge is one of the 12 things Americans do all day; its height is the share of
            the country doing it, minute by minute from 4&nbsp;a.m. to 4&nbsp;a.m. Built
            from {stats.meta.n2024.toLocaleString()} real diary days. Drag to look around.
          </p>
          <p class="cue" aria-hidden="true">scroll ↓</p>
        </div>
      </section>

      <section class="step" data-view="night">
        <div class="card">
          <h2>The night is one mountain</h2>
          <p>
            The sleep massif crests at 3&nbsp;a.m., when <b>{stats.headline.at3am}%</b> of the
            country is inside the same hour of rest. Nothing else in the day builds anything
            close.
          </p>
        </div>
      </section>

      <section class="step" data-view="work">
        <div class="card">
          <h2>Work is a plateau</h2>
          <p>
            From 9 to 11 and again after lunch, work holds a steady three in ten Americans —
            <b>{h[10].share}%</b> in the 10&nbsp;a.m. hour. It is the flattest, most engineered
            shape in the terrain: the only activity with walls this straight.
          </p>
        </div>
      </section>

      <section class="step tall" data-view="indoors" data-scrub>
        <div class="card">
          <h2>The workday didn’t move. It moved indoors.</h2>
          <p>
            As you scroll, the terrain rewinds to 2019 and returns. The pale shelf inside the work
            plateau is work done <em>at home</em> — <b>{I.homeMinuteShare2019}%</b> of America’s
            work minutes in 2019, <b>{I.homeMinuteShare2024}%</b> in 2024. Meanwhile the country’s
            commuters fell from <b>{I.commutersM2019}M</b> a day to <b>{I.commutersM2024}M</b> —
            and the ones still commuting go longer: {Math.round(I.commuteLen2019)} minutes each
            way in 2019, {Math.round(I.commuteLen2024)} now.
          </p>
        </div>
      </section>

      <section class="step" data-view="evening">
        <div class="card">
          <h2>Television raises an evening ridge</h2>
          <p>
            Leisure builds all afternoon and crests between 8 and 9&nbsp;p.m. at
            <b> {h[20].share}%</b> of the country — most of it television — then drains into the
            night massif before midnight.
          </p>
        </div>
      </section>

      <section class="step" data-view="explore" data-explore>
        <div class="card">
          <h2>Walk the range</h2>
          <p>Drag to orbit. Hover a ridge for the numbers. Or rewind five years:</p>
        </div>
      </section>

      <div class="yearchips" inert>
        <button class="ychip" data-year="2019">2019</button>
        <button class="ychip on" data-year="2024">2024</button>
      </div>
    </div>

    <footer>
      <p class="source">{stats.meta.sourceLine}</p>
      <p class="fine">
        Civilian, noninstitutional population age 15 and over, living in households, 50 states and
        D.C. Activities are the 12 published ATUS categories, population-weighted; the 2019
        terrain uses that year’s {stats.meta.n2019.toLocaleString()} diary days. The pandemic
        interrupted the 2020 survey — BLS states annual 2020 estimates cannot be made, so the
        morph spans the gap. Hover figures are the share of that clock hour.
      </p>
      <nav>
        <span>Three ways to read the same day:</span>
        <a href="/fray">The Fray</a>
        <a href="/ledger">The Ledger</a>
        <a aria-current="page" href="/terrain">The Terrain</a>
      </nav>
    </footer>

    <script>
      import { boot } from '../lib/terrain/main.js';
      boot(document.getElementById('terrain'));
    </script>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #10122b;
        --ink: #e9eaf5;
        --muted: #9aa0c2;
        --hair: rgba(233, 234, 245, 0.15);
        --card: rgba(14, 16, 38, 0.84);
        --mono: 'Chivo Mono Variable', ui-monospace, monospace;
        --sans: 'Bricolage Grotesque Variable', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--bg); color: var(--ink); overflow-x: clip; }
      body { font: 400 1rem/1.55 var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; }

      .scrolly { position: relative; padding-bottom: 56vh; }
      .stage { position: sticky; top: 0; height: 100dvh; overflow: hidden; }
      canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
      .loading { position: absolute; inset: 0; display: grid; place-content: center; font: 12px var(--mono); color: var(--muted); letter-spacing: 0.08em; }

      .labels { position: absolute; inset: 0; pointer-events: none; }
      .labels span {
        position: absolute; left: 0; top: 0; white-space: nowrap;
        font: 11px var(--mono); color: var(--muted); letter-spacing: 0.05em;
        transition: opacity 0.3s;
      }
      .labels span.ridge { color: var(--ink); opacity: 0.85; }
      .labels span.wah { color: #9fe8ff; }
      .labels span.axis { opacity: 0.55; }

      .brand {
        position: absolute; top: 14px; left: 18px; display: flex; gap: 8px; align-items: baseline;
        font: 12px var(--mono); letter-spacing: 0.04em; color: var(--muted); z-index: 3;
      }
      .brand a { text-decoration: none; opacity: 0.75; }
      .brand a:hover { opacity: 1; }
      .brand b { color: var(--ink); font-weight: 400; }

      .readout {
        position: absolute; top: 16px; left: 50%; transform: translateX(-50%);
        font: 12.5px var(--mono); color: var(--ink); white-space: nowrap;
        background: var(--card); border: 1px solid var(--hair); border-radius: 6px;
        padding: 6px 12px; opacity: 0; transition: opacity 0.15s; pointer-events: none; z-index: 3;
      }
      .readout.show { opacity: 1; }
      .readout b { font-weight: 600; color: #fff; }

      .step { position: relative; min-height: 110vh; display: flex; align-items: center; padding: 0 6vw; z-index: 1; pointer-events: none; }
      .step.tall { min-height: 210vh; align-items: flex-start; }
      .step.tall .card { position: sticky; top: 26vh; }
      .step.hero { margin-top: -100dvh; padding-top: 20vh; min-height: 135vh; align-items: flex-start; }
      .step.hero .card { position: relative; }
      .step.hero .card::before {
        content: ''; position: absolute; inset: -20% -12%; z-index: -1; pointer-events: none;
        background: radial-gradient(ellipse 72% 62% at 40% 40%, rgba(16, 18, 43, 0.85), rgba(16, 18, 43, 0.42) 58%, transparent 80%);
      }
      .step .card {
        pointer-events: auto; max-width: 30rem;
        background: var(--card); border: 1px solid var(--hair); border-radius: 12px;
        padding: 22px 26px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      }
      .step.hero .card { background: none; border: none; backdrop-filter: none; padding: 0; max-width: 34rem; }
      h1 {
        margin: 0 0 0.55em; font-size: clamp(1.8rem, 4.4vw, 2.7rem); line-height: 1.08;
        font-weight: 640; letter-spacing: -0.02em; text-wrap: balance;
        text-shadow: 0 1px 24px rgba(16, 18, 43, 0.95);
      }
      .hero p { color: #c7cbe4; max-width: 46ch; text-shadow: 0 1px 14px rgba(16, 18, 43, 0.95); }
      .cue { font: 11px var(--mono); letter-spacing: 0.14em; color: var(--muted); margin-top: 2.2em; }
      h2 { margin: 0 0 0.45em; font-size: 1.12rem; font-weight: 620; }
      .step p { margin: 0; font-size: 0.94rem; color: var(--muted); }
      .step b, .step em { color: var(--ink); font-weight: 600; font-style: normal; }

      .yearchips {
        position: fixed; left: 50%; transform: translateX(-50%); bottom: 26px;
        display: flex; gap: 8px; z-index: 3; opacity: 0; transition: opacity 0.4s;
      }
      .yearchips.show { opacity: 1; }
      .ychip {
        font: 13px var(--mono); letter-spacing: 0.06em; color: var(--muted);
        background: var(--card); border: 1px solid var(--hair); border-radius: 999px;
        padding: 8px 18px; cursor: pointer;
      }
      .ychip:hover { color: var(--ink); }
      .ychip.on { color: var(--bg); background: var(--ink); border-color: var(--ink); }

      footer { position: relative; z-index: 2; background: var(--bg); border-top: 1px solid var(--hair); padding: 46px 6vw 60px; }
      .source { font: 12.5px var(--mono); letter-spacing: 0.02em; color: var(--ink); margin: 0 0 14px; }
      .fine { color: var(--muted); font-size: 0.85rem; max-width: 68ch; margin: 0 0 26px; }
      footer nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 0.9rem; align-items: baseline; }
      footer nav span { color: var(--muted); font-size: 0.85rem; }
      footer nav a { text-decoration-color: var(--hair); text-underline-offset: 4px; }
      footer nav a[aria-current] { text-decoration: none; color: var(--muted); }

      @media (max-width: 719px) {
        .step { padding: 0 4vw; align-items: flex-end; }
        .step .card { padding: 16px 16px; margin-bottom: 12vh; }
        .step.tall { align-items: flex-start; }
        .step.tall .card { position: sticky; top: 52vh; margin-bottom: 0; }
        .step .card p { font-size: 0.88rem; }
        h2 { font-size: 1.02rem; }
        .step.hero { padding-top: 16vh; align-items: flex-start; }
        .step.hero .card { margin-bottom: 0; }
        .labels span.axis:nth-child(even) { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .cue { display: none; }
      }
    </style>
  </body>
</html>
