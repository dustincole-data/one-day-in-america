---
// One Day in America — the whole site. Night is the ground; the piece lives at
// the root and there is no chooser.
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/fragment-mono';
import stats from '../gen/stats.json';
import { MAJORS, LABELS, BAND_ORDER } from '../lib/atus/meta.js';
import { GROUND } from '../lib/atus/ground.js';
import Findings from '../components/Findings.astro';
import Explorer from '../components/Explorer.astro';
import DcdMark from '../components/DcdMark.astro';
import '../styles/piece.css';

const fmtAvg = (min) => {
  const r = Math.round(min), hh = Math.floor(r / 60), mm = r % 60;
  return hh ? `${hh}h ${String(mm).padStart(2, '0')}m` : `${mm}m`;
};
const avg = Object.fromEntries(stats.ledger.byMajor.map((r) => [r.major, r.y2024]));
const h = Object.fromEntries(stats.headline.hourly.map((r) => [r.hour, r]));
const hw = Object.fromEntries(stats.headline.hourlyWorkers.map((r) => [r.hour, r]));

// The rail shows the five largest bands by default — enough to read the fabric
// without a wall of text — and opens to all twelve on demand.
const byShare = [...stats.ledger.byMajor].sort((a, b) => b.y2024 - a.y2024).map((r) => r.major);
const RAIL = byShare.slice(0, 5);

const title = 'One Day in America';
// C11: away from the graphic the claim is stated as the modal share, never as
// "no two days are alike".
const desc = `Every American day, drawn from ${stats.meta.n2024.toLocaleString()} real diary days. ` +
  `In the 3 a.m. hour the most common single activity holds ${stats.headline.at3am}% of the country; at noon, ${stats.headline.atNoon}%.`;

const cssVars = [
  `--bg:${GROUND.bg}`, `--ink:${GROUND.ink}`, `--muted:${GROUND.muted}`, `--hair:${GROUND.hair}`,
  `--card:${GROUND.card}`, `--card-solid:${GROUND.cardSolid}`, `--well:${GROUND.well}`,
  `--strong:${GROUND.strong}`,
  ...MAJORS.map((m) => `--c-${m}:${GROUND.palette[m]}`),
].join(';');
---

<!doctype html>
<html lang="en" style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="/og/night.png" />
    <meta name="theme-color" content={GROUND.bg} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style set:html={':root{color-scheme:dark}'}></style>
  </head>

  <body>
    <div class="scrolly" id="fray">
      <div class="stage">
        <!-- the label takes its exact count from the renderer: the drawing thins
             the payload to about one thread per pixel of fabric, so how many
             threads there are follows the size of the screen -->
        <canvas aria-label="Real diary days drawn as horizontal threads across one day, grouped by activity"></canvas>
        <p class="loading">weaving the fabric…</p>
        <div class="hairline" aria-hidden="true"></div>
        <div class="readout" aria-hidden="true"></div>
        <div class="axis" aria-hidden="true"></div>
        <header class="brand">One Day in America</header>
        <DcdMark placement="corner" />

        <!-- the key, on the page rather than behind a corner button -->
        <div class="keyrail">
          <div class="keyrail-list">
            {RAIL.map((m) => (
              <button data-major={m}><i style={`background:var(--c-${m})`}></i><span>{LABELS[m]}</span></button>
            ))}
          </div>
          <button class="keyrail-more" aria-expanded="false" aria-controls="keypanel">all 12</button>
        </div>
        <div class="keypanel" id="keypanel" hidden>
          <p class="kp-head">average day, 2024</p>
          <div class="kp-grid">
            {BAND_ORDER.map((m) => (
              <button data-major={m}>
                <i style={`background:var(--c-${m})`}></i><span>{LABELS[m]}</span><b>{fmtAvg(avg[m])}</b>
              </button>
            ))}
          </div>
        </div>
      </div>

      <section class="step hero" data-galpha="0.42">
        <div class="card">
          <h1>Everyone’s 3&nbsp;a.m. looks the same.<br />Nobody’s noon does.</h1>
          <p>
            In 2024, {stats.meta.n2024.toLocaleString()} Americans wrote down one whole day for the
            Bureau of Labor Statistics. Every thread in this drawing is one of them<span data-drawn
            ></span>.
          </p>
          <p class="cue" aria-hidden="true">scroll ↓</p>
        </div>
      </section>

      <section class="step step-trace" data-trace>
        <div class="card">
          <h2>Every line is one person</h2>
          <p>One real day, 4&nbsp;a.m. to 4&nbsp;a.m. Colour is what they were doing.</p>
          <div class="trace-day" aria-live="off"></div>
        </div>
      </section>

      <section class="step">
        <div class="card">
          <h2>Read it like this</h2>
          <p>
            Lines stack into bands by activity. How thick a band is, is how many people are in it.
          </p>
        </div>
      </section>

      <section class="step" data-dim="1320,1439">
        <div class="card">
          <h2>The quietest hour</h2>
          <p>
            In the 3&nbsp;a.m. hour <b>{stats.headline.at3am}%</b> of the country is on one
            activity — {stats.headline.asleepAt3am}% simply asleep.
          </p>
        </div>
      </section>

      <section class="step" data-dim="480,540">
        <div class="card">
          <h2>Noon is the loosest</h2>
          <p>
            By 8&nbsp;a.m. no single activity holds even 30%. At noon the largest — work — holds
            <b>{stats.headline.atNoon}%</b>, <b>{stats.headline.gapPp} points</b> below 3&nbsp;a.m.
          </p>
        </div>
      </section>

      <section class="step" data-dim="960,1200">
        <div class="card">
          <h2>Evening pulls it back</h2>
          <p>
            At 8&nbsp;p.m. leisure is the biggest band, <b>{h[20].share}%</b>. By 11&nbsp;p.m.
            <b>{h[23].share}%</b> agree again.
          </p>
        </div>
      </section>

      <section class="step" data-filter="workers6wd" data-dim="540,960">
        <div class="card">
          <h2>Filter it and the fabric changes</h2>
          <p>
            Only people who worked six hours or more on a weekday: <b>{hw[14].share}%</b> are at
            work at 2&nbsp;p.m.
          </p>
        </div>
      </section>

      <section class="step" data-filter="everyone" data-explore>
        <div class="card">
          <h2>Try it yourself</h2>
          <p>Re-weave the fabric, or tap a thread to follow one whole day.</p>
          <div class="chips">
            <button class="chip on" data-filter="everyone">Everyone</button>
            <button class="chip" data-filter="worked">Worked that day</button>
            <button class="chip" data-filter="weekend">Weekend</button>
            <button class="chip" data-filter="kids">Kids at home</button>
            <button class="chip" data-filter="age65">65 and over</button>
          </div>
        </div>
      </section>

      <aside class="daycard" inert></aside>
    </div>

    <main class="findings">
      <div class="findings-intro">
        <p class="f-kicker">The rest of the day</p>
        <p>Six findings, then a way to ask your own question.</p>
      </div>

      <Findings />
      <Explorer />
    </main>

    <footer>
      <p class="source">{stats.meta.sourceLine}</p>

      <details class="method">
        <summary>Method</summary>
        <p>
          Civilian, noninstitutional population age 15 and over, living in households, 50 states and
          D.C. Activities are the 12 published ATUS categories; every share is weighted with BLS
          person-day weights. The drawing is built from a systematic probability-proportional-to-size
          sample of 2,600 of those {stats.meta.n2024.toLocaleString()} days — so equal ink per thread
          draws an honest picture. It is thinned once more before it is drawn, by a systematic stride
          that keeps that ordering, to about one thread per pixel of fabric; the thread count in the
          opening line is the number that actually reached this screen. Hour figures are the share
          of that clock hour spent on the most common
          single activity. Sections 03 through 07 pool {stats.explore.years[0]} and
          {' '}{stats.explore.years[1]} for sample size. 2020 is excluded: the survey was suspended
          for part of that year and BLS publishes no annual estimate for it. The drawings are
          generated atmosphere and carry no data.
        </p>
      </details>
    </footer>

    <script>
      import { boot } from '../lib/fray/main.js';
      import { boot as bootExplorer } from '../lib/explore/main.js';

      boot(document.getElementById('fray'));

      const ex = document.querySelector('[data-explorer]');
      // the explorer payload is 190 KB — only fetch it once it is close to view
      const exIo = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        exIo.disconnect();
        bootExplorer(ex);
      }, { rootMargin: '400px' });
      exIo.observe(ex);
    </script>
  </body>
</html>
