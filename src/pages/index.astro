---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/fragment-mono';
import stats from '../gen/stats.json';
import { SKINS, SKIN_ORDER, SKIN_PATH } from '../lib/atus/skins.js';

const title = 'One Day in America';
const desc = `How ${stats.meta.n2024.toLocaleString()} Americans actually spent a day. In the 3 a.m. hour the most common single activity holds ${stats.headline.at3am}% of the country; at noon, ${stats.headline.atNoon}%.`;

const grounds = SKIN_ORDER.map((k) => ({
  key: k, name: SKINS[k].name, blurb: SKINS[k].blurb,
  href: SKIN_PATH[k], img: `/previews/${k}.webp`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="/og/night.png" />
    <meta name="theme-color" content="#0b0d16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <header>
        <h1>One Day in America</h1>
        <p>
          In 2024, {stats.meta.n2024.toLocaleString()} Americans wrote down one whole day for the
          Bureau of Labor Statistics — what they were doing, minute by minute, 4&nbsp;a.m. to
          4&nbsp;a.m. This is that day: the weave, seven findings, and an explorer that will answer
          questions nobody has asked it yet.
        </p>
        <p class="choose">One piece, three grounds. Same data, same structure.</p>
      </header>

      {grounds.map((g) => (
        <a class="piece" href={g.href}>
          <img src={g.img} alt={`Preview of the ${g.name} ground`} loading="lazy" />
          <span class="veil" aria-hidden="true"></span>
          <span class="meta">
            <b>{g.name}</b>
            <span class="line">{g.blurb}</span>
          </span>
        </a>
      ))}

      <footer>
        <p class="source">{stats.meta.sourceLine}</p>
        <p class="fine">
          Civilian, noninstitutional population age 15 and over, living in households, 50 states
          and D.C. All figures weighted with BLS person-day weights over the 12 published ATUS
          activity categories.
        </p>
        <p class="sig"><a href="https://dustincoledata.com">Dustin Cole Data</a></p>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0b0d16;
        --ink: #e9eaf2;
        --muted: #9ea1b6;
        --hair: rgba(233, 234, 242, 0.14);
        --mono: 'Fragment Mono', ui-monospace, monospace;
        --sans: 'Schibsted Grotesk Variable', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--bg); color: var(--ink); overflow-x: clip; }
      body { font: 400 1rem/1.55 var(--sans); -webkit-font-smoothing: antialiased; }

      main { max-width: 1060px; margin: 0 auto; padding: 0 5vw; }
      header { padding: 11vh 0 7vh; }
      h1 { margin: 0 0 0.4em; font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 560; letter-spacing: -0.014em; }
      header p { margin: 0; color: var(--muted); max-width: 54ch; }
      .choose {
        margin-top: 1.8em !important; font: 11px var(--mono); letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--muted);
      }

      .piece {
        position: relative; display: block; margin: 0 0 34px; border-radius: 14px; overflow: hidden;
        border: 1px solid var(--hair); text-decoration: none; color: inherit;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s;
      }
      .piece:hover { transform: translateY(-3px); border-color: rgba(233, 234, 242, 0.32); }
      .piece img { display: block; width: 100%; aspect-ratio: 16 / 8.4; object-fit: cover; }
      .veil {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(11, 13, 22, 0.9) 0%, rgba(11, 13, 22, 0.34) 38%, transparent 62%);
      }
      .meta { position: absolute; left: 22px; right: 22px; bottom: 18px; display: block; }
      .meta b { display: block; font-size: 1.25rem; font-weight: 580; letter-spacing: -0.008em; }
      .meta .line { display: block; margin-top: 4px; color: #c9ccdd; font-size: 0.92rem; max-width: 62ch; }

      footer { padding: 30px 0 70px; }
      .source { font: 12.5px var(--mono); letter-spacing: 0.02em; margin: 0 0 12px; }
      .fine { color: var(--muted); font-size: 0.84rem; max-width: 66ch; margin: 0; }
      .sig {
        margin: 30px 0 0; padding-top: 20px; border-top: 1px solid var(--hair);
        font: 11px var(--mono); letter-spacing: 0.16em; text-transform: uppercase;
      }
      .sig a { color: var(--muted); text-decoration: none; }
      .sig a:hover { color: var(--ink); }

      @media (max-width: 719px) {
        header { padding: 9vh 0 5vh; }
        .piece img { aspect-ratio: 4 / 3.4; }
        .meta { left: 14px; right: 14px; bottom: 12px; }
        .meta .line { font-size: 0.85rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .piece { transition: none; }
      }
    </style>
  </body>
</html>
